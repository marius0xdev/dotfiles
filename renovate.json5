// Renovate (GitHub app) opens a PR when a pinned mise tool or GitHub Action has
// a newer release and keeps an open "Dependency Dashboard" issue listing
// pending updates.
// Updates are never merged automatically: review, `mise install`, test, merge.
// JSON5 rather than renovate.json so every rule can carry a comment, like the
// Brewfile and the mise config (JSON allows no comments).
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  // Only the mise tools and the workflows' actions: the Brewfile has no
  // versions, the Homebrew installer pin needs independent verification, and
  // Renovate has no lazy.nvim manager.
  enabledManagers: ['mise', 'custom.regex', 'github-actions'],
  automerge: false,
  // .github/workflows/consul-template-checksums.yml commits to Renovate's
  // consul-template PRs; without this Renovate would stop updating them.
  gitIgnoredAuthors: ['41898282+github-actions[bot]@users.noreply.github.com'],
  customManagers: [
    {
      // consul-template uses mise's http backend, which Renovate can't read.
      // Renovate bumps only `version`; the workflow above fixes URLs/checksums.
      customType: 'regex',
      managerFilePatterns: ['**/.config/mise/config.toml'],
      matchStrings: [
        '\\[tools\\."http:consul-template"\\]\\nversion = "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'hashicorp/consul-template',
      datasourceTemplate: 'github-releases',
      extractVersionTemplate: '^v(?<version>.+)$',
    },
  ],
  packageRules: [
    {
      // sofka releases every few days; pin one at least two weeks old.
      matchDepNames: ['sofka'],
      minimumReleaseAge: '14 days',
    },
  ],
}
