# Interactive zsh settings managed by the dotfiles repo.
# Sourced from ~/.zshrc (bootstrap.sh appends the source line); the rest of
# ~/.zshrc stays user-managed.

# mise: ~/.zprofile only puts shims on PATH, which don't load per-project
# settings. `mise activate` runs `mise hook-env` on every prompt and `cd`, so a
# project's mise.toml [env], [shell_alias] and tool versions apply in the shell.
command -v mise >/dev/null && eval "$(mise activate zsh)"

# Completion: enable it unless ~/.zshrc (e.g. Oh My Zsh) already ran compinit.
# zsh ships completions for tmux, git, etc.; aliases complete like their
# targets (COMPLETE_ALIASES is off), so `t <Tab>` completes tmux commands.
if (( ! $+functions[compdef] )); then
  autoload -Uz compinit
  compinit
fi

# Completions generated by mise-installed tools (they need compinit above).
command -v kubectl >/dev/null && source <(kubectl completion zsh)
command -v sofka >/dev/null && source <(sofka completion zsh)
command -v doctl >/dev/null && source <(doctl completion zsh)

# fzf-tab (Homebrew) shows Tab completions in fzf instead of zsh's menu. It must
# load after compinit and before plugins that wrap widgets (e.g.
# zsh-autosuggestions). `[%d]` adds group headers and `<` / `>` switch groups
# (fzf-tab's default is F1 / F2); git checkout candidates keep git's order.
fzf_tab=${HOMEBREW_PREFIX:-/opt/homebrew}/share/fzf-tab/fzf-tab.zsh
if [[ -r $fzf_tab ]] && command -v fzf >/dev/null; then
  source "$fzf_tab"
  zstyle ':completion:*:descriptions' format '[%d]'
  zstyle ':completion:*:git-checkout:*' sort false
  zstyle ':fzf-tab:*' switch-group '<' '>'
fi
unset fzf_tab

# Vi mode for the command line (same as `bindkey -v`). Caps Lock is Escape.
set -o vi
# Switch to normal mode 10ms after Escape instead of zsh's default 400ms.
KEYTIMEOUT=1
# zsh's vi insert keymap doesn't bind Ctrl+R; keep incremental history search
# as a fallback when Atuin isn't installed.
bindkey -M viins '^R' history-incremental-search-backward
bindkey -M vicmd '^R' history-incremental-search-backward

# Atuin replaces Ctrl+R with its searchable history (after vi mode, so it binds
# the vi keymaps). The Up arrow keeps zsh's normal history navigation.
if command -v atuin >/dev/null; then
  eval "$(atuin init zsh --disable-up-arrow)"
fi

# Aliases
alias v='nvim'
alias t='tmux'
alias k='kubectl'

# dev [dir]: open a tmux session for a project directory (default: current),
# named after the directory, with windows (Option + 1..6):
#   1 nvim  2 lazygit  3 zsh  4 sofka  5 claude  6 diary (~/Diary/YYYY-MM-DD.md)
# Commands are typed into shells, so quitting one leaves the window's shell.
# If the session already exists, it is reattached as is.
dev() {
  local dir=${${1:-$PWD}:A}
  if [[ ! -d $dir ]]; then
    print -u2 "dev: not a directory: $dir"
    return 1
  fi
  # tmux session names can't contain '.' or ':'.
  local name=${${dir:t}//[.:]/_}

  if ! tmux has-session -t "=$name" 2>/dev/null; then
    local diary=$HOME/Diary
    mkdir -p "$diary"
    tmux new-session -d -s "$name" -c "$dir" -n nvim
    tmux send-keys -t "=$name:1" 'nvim' Enter
    tmux new-window -d -t "=$name:2" -c "$dir" -n lazygit
    tmux send-keys -t "=$name:2" 'lazygit' Enter
    tmux new-window -d -t "=$name:3" -c "$dir" -n zsh
    tmux new-window -d -t "=$name:4" -c "$dir" -n sofka
    tmux send-keys -t "=$name:4" 'sofka' Enter
    tmux new-window -d -t "=$name:5" -c "$dir" -n claude
    tmux send-keys -t "=$name:5" 'claude' Enter
    tmux new-window -d -t "=$name:6" -c "$diary" -n diary
    tmux send-keys -t "=$name:6" "nvim $(date +%F).md" Enter
    tmux select-window -t "=$name:1"
  fi

  if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$name"
  else
    tmux attach-session -t "=$name"
  fi
}
