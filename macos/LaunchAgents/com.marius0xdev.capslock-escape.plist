<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Remap Caps Lock (HID usage 0x39) to Escape (0x29) on all keyboards at login.
  Installed by bootstrap.sh into ~/Library/LaunchAgents (copied, not stowed).
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.marius0xdev.capslock-escape</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/hidutil</string>
    <string>property</string>
    <string>--set</string>
    <string>{"UserKeyMapping":[{"HIDKeyboardModifierMappingSrc":0x700000039,"HIDKeyboardModifierMappingDst":0x700000029}]}</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
